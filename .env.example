# ============================================================================
# CampusTrack — Environment Configuration Template
# ============================================================================

# --- Java Backend Environment Variables ---
# Complete JDBC URL (takes precedence if defined)
# DB_URL=jdbc:mysql://your-cloud-db-host:3306/campustrack?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Discrete MySQL connection parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campustrack
DB_USER=root
DB_PASSWORD=your_secure_db_password

# Application Server Port (Tomcat / Container)
PORT=8080

# Secret Key for HMAC-SHA256 JWT Authentication (min 32 characters)
JWT_SECRET=CampusTrackSecureSecretKey2026!9876543210#@

# Allowed CORS Origins (Frontend origin e.g. https://your-app.vercel.app, http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://campustrack.vercel.app

# --- Vercel Frontend Environment Variables ---
# Set this in your Vercel Project Settings -> Environment Variables
# API Base URL pointing to your deployed Java Tomcat backend
VITE_API_BASE_URL=https://campustrack-backend.up.railway.app/api
